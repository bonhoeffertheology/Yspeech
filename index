<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
  <title>Smart Voice Prompter</title>
  <style>
    :root {
      --bg-color: #0d0e12;
      --text-muted: #525866;
      --text-active: #ffffff;
      --accent-color: #3b82f6;
      --highlight-bg: rgba(59, 130, 246, 0.15);
      --font-size: 32px;
      --line-height: 1.8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-muted);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      height: 100vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    /* 상단 제어 바 (태블릿 최적화) */
    header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      padding: 12px 24px;
      background: #161922;
      border-bottom: 1px solid #282f3e;
      gap: 12px;
      z-index: 10;
    }

    .controls-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    button {
      background: #252b3b;
      color: #e2e8f0;
      border: 1px solid #3c445c;
      padding: 10px 18px;
      font-size: 15px;
      font-weight: 600;
      border-radius: 8px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
    }

    button:active {
      transform: scale(0.97);
    }

    button.primary {
      background: var(--accent-color);
      border-color: var(--accent-color);
      color: #fff;
    }

    button.active {
      background: #ef4444;
      border-color: #ef4444;
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0% { opacity: 1; }
      50% { opacity: 0.6; }
      100% { opacity: 1; }
    }

    .slider-container {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #94a3b8;
      font-size: 14px;
    }

    input[type="range"] {
      cursor: pointer;
      accent-color: var(--accent-color);
    }

    /* 본문 프롬프터 컨테이너 */
    #prompter-container {
      flex: 1;
      overflow-y: auto;
      padding: 35vh 12vw; /* 상·하단 패딩으로 활성 문장이 중앙에 오도록 배치 */
      scroll-behavior: smooth;
    }

    .chunk {
      font-size: var(--font-size);
      line-height: var(--line-height);
      margin-bottom: 2rem;
      padding: 12px 16px;
      border-radius: 12px;
      transition: color 0.3s ease, background 0.3s ease, transform 0.2s ease;
      cursor: pointer;
    }

    .chunk.active {
      color: var(--text-active);
      background: var(--highlight-bg);
      font-weight: 700;
      transform: scale(1.02);
      border-left: 4px solid var(--accent-color);
    }

    .chunk.past {
      color: #2b3040;
    }

    /* 텍스트 편집 모달 */
    #editor-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.8);
      z-index: 20;
      padding: 24px;
      flex-direction: column;
    }

    #editor-modal.open {
      display: flex;
    }

    textarea {
      flex: 1;
      background: #11141c;
      color: #f8fafc;
      border: 1px solid #334155;
      border-radius: 8px;
      padding: 16px;
      font-size: 18px;
      line-height: 1.6;
      resize: none;
      outline: none;
      margin-bottom: 16px;
    }

    /* 상태 표시 바 */
    #status-bar {
      padding: 6px 24px;
      font-size: 13px;
      background: #090a0d;
      color: #64748b;
      display: flex;
      justify-content: space-between;
    }
  </style>
</head>
<body>

  <header>
    <div class="controls-group">
      <button id="btn-toggle" class="primary">🎙️ 인식 시작</button>
      <button id="btn-edit">✏️ 원고 수정</button>
    </div>
    
    <div class="controls-group">
      <div class="slider-container">
        <label for="font-size">글자 크기</label>
        <input type="range" id="font-size" min="20" max="56" value="32" />
      </div>
      <button id="btn-reset">처음으로</button>
    </div>
  </header>

  <div id="prompter-container"></div>

  <div id="status-bar">
    <span id="speech-preview">대기 중...</span>
    <span id="index-counter">0 / 0</span>
  </div>

  <!-- 원고 수정 모달 -->
  <div id="editor-modal">
    <textarea id="script-input" placeholder="여기에 발표 원고나 스크립트를 입력하세요..."></textarea>
    <div style="display:flex; justify-content: flex-end; gap: 12px;">
      <button id="btn-cancel">취소</button>
      <button id="btn-save" class="primary">적용하기</button>
    </div>
  </div>

  <script>
    // --- 기본 샘플 텍스트 ---
    const DEFAULT_SCRIPT = `안녕하세요. 오늘 발표를 시작하겠습니다.
음성 인식 프롬프터는 발표자의 호흡과 발화 속도에 맞추어 자동으로 스크롤됩니다.
태블릿 환경에 맞추어 화면 어디든 터치하여 원하는 문장으로 이동할 수도 있습니다.
인식률이 떨어지는 환경에서도 당황하지 않고 수동 스크롤을 병행할 수 있도록 설계되었습니다.
이제 준비한 원고를 입력하고 프롬프터를 직접 테스트해 보세요.`;

    // --- State 관리 ---
    const state = {
      chunks: [],
      currentIndex: 0,
      isListening: false,
      recognition: null
    };

    const container = document.getElementById('prompter-container');
    const btnToggle = document.getElementById('btn-toggle');
    const btnEdit = document.getElementById('btn-edit');
    const btnReset = document.getElementById('btn-reset');
    const modal = document.getElementById('editor-modal');
    const scriptInput = document.getElementById('script-input');
    const btnSave = document.getElementById('btn-save');
    const btnCancel = document.getElementById('btn-cancel');
    const speechPreview = document.getElementById('speech-preview');
    const indexCounter = document.getElementById('index-counter');
    const fontSizeSlider = document.getElementById('font-size');

    // --- 텍스트 전처리 및 청크 파싱 ---
    function parseScript(text) {
      return text
        .split(/\n+/)
        .map(line => line.trim())
        .filter(line => line.length > 0);
    }

    function renderScript() {
      container.innerHTML = '';
      state.chunks.forEach((chunk, idx) => {
        const el = document.createElement('div');
        el.className = `chunk ${idx === state.currentIndex ? 'active' : ''}`;
        el.innerText = chunk;
        el.dataset.index = idx;
        
        // 터치/클릭 시 해당 위치로 즉각 이동
        el.addEventListener('click', () => {
          setCurrentIndex(idx);
        });

        container.appendChild(el);
      });
      updateCounter();
      scrollToCurrent();
    }

    function setCurrentIndex(idx) {
      if (idx < 0 || idx >= state.chunks.length) return;
      state.currentIndex = idx;
      
      const elements = container.querySelectorAll('.chunk');
      elements.forEach((el, i) => {
        el.className = 'chunk';
        if (i < idx) el.classList.add('past');
        if (i === idx) el.classList.add('active');
      });

      updateCounter();
      scrollToCurrent();
    }

    function scrollToCurrent() {
      const activeEl = container.querySelector('.chunk.active');
      if (activeEl) {
        activeEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    function updateCounter() {
      indexCounter.innerText = `${state.currentIndex + 1} /${state.chunks.length}`;
    }

    // --- 텍스트 매칭 알고리즘 (간단 자카드 유사도) ---
    function cleanText(str) {
      return str.replace(/[.,\/#!$%\^&\*;:{}=\-_`~()]/g, "").toLowerCase();
    }

    function findMatchingChunk(transcript) {
      const cleanTranscript = cleanText(transcript);
      const transcriptWords = new Set(cleanTranscript.split(/\s+/));
      
      let bestMatchIndex = -1;
      let highestScore = 0;

      // 현재 읽는 위치 기준 앞뒤 3개 문장 범위 우선 탐색
      const start = Math.max(0, state.currentIndex);
      const end = Math.min(state.chunks.length, state.currentIndex + 4);

      for (let i = start; i < end; i++) {
        const chunkWords = cleanText(state.chunks[i]).split(/\s+/);
        let intersection = 0;

        chunkWords.forEach(word => {
          if (transcriptWords.has(word)) intersection++;
        });

        const score = intersection / Math.max(chunkWords.length, 1);
        if (score > 0.25 && score > highestScore) { // 최소 25% 단어 매칭
          highestScore = score;
          bestMatchIndex = i;
        }
      }

      return bestMatchIndex;
    }

    // --- 음성 인식 Web Speech API 설정 ---
    function initSpeechRecognition() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        alert("현재 브라우저는 Web Speech API를 지원하지 않습니다. Chrome 또는 Safari 최신 버전을 권장합니다.");
        btnToggle.disabled = true;
        return;
      }

      const rec = new SpeechRecognition();
      rec.continuous = true;
      rec.interimResults = true;
      rec.lang = 'ko-KR';

      rec.onresult = (event) => {
        let interimTranscript = '';
        for (let i = event.resultIndex; i < event.results.length; ++i) {
          const text = event.results[i][0].transcript;
          interimTranscript += text;
          
          if (event.results[i].isFinal) {
            const matchedIdx = findMatchingChunk(text);
            if (matchedIdx !== -1 && matchedIdx >= state.currentIndex) {
              setCurrentIndex(matchedIdx);
            }
          }
        }
        speechPreview.innerText = `인식 중: ${interimTranscript.slice(-30)}`;
        
        // 중간 인식(interim) 결과로도 빠른 추적
        const quickMatch = findMatchingChunk(interimTranscript);
        if (quickMatch !== -1 && quickMatch > state.currentIndex) {
          setCurrentIndex(quickMatch);
        }
      };

      rec.onerror = (e) => {
        console.error("Speech Recognition Error:", e.error);
        if (e.error === 'not-allowed') {
          alert("마이크 권한이 필요합니다.");
          stopListening();
        }
      };

      rec.onend = () => {
        // 지속 인식을 위한 재시작 처리
        if (state.isListening) {
          try {
            rec.start();
          } catch(err) {}
        }
      };

      state.recognition = rec;
    }

    function startListening() {
      if (!state.recognition) initSpeechRecognition();
      try {
        state.recognition.start();
        state.isListening = true;
        btnToggle.innerText = '⏹️ 인식 정지';
        btnToggle.classList.add('active');
        speechPreview.innerText = "듣는 중...";
      } catch (e) {
        console.error(e);
      }
    }

    function stopListening() {
      if (state.recognition) {
        state.isListening = false;
        state.recognition.stop();
        btnToggle.innerText = '🎙️ 인식 시작';
        btnToggle.classList.remove('active');
        speechPreview.innerText = "정지됨";
      }
    }

    // --- 이벤트 바인딩 ---
    btnToggle.addEventListener('click', () => {
      if (state.isListening) stopListening();
      else startListening();
    });

    btnReset.addEventListener('click', () => {
      setCurrentIndex(0);
    });

    btnEdit.addEventListener('click', () => {
      scriptInput.value = state.chunks.join('\n\n');
      modal.classList.add('open');
    });

    btnSave.addEventListener('click', () => {
      const newText = scriptInput.value.trim();
      if (newText) {
        state.chunks = parseScript(newText);
        state.currentIndex = 0;
        renderScript();
      }
      modal.classList.remove('open');
    });

    btnCancel.addEventListener('click', () => {
      modal.classList.remove('open');
    });

    fontSizeSlider.addEventListener('input', (e) => {
      document.documentElement.style.setProperty('--font-size', `${e.target.value}px`);
      scrollToCurrent();
    });

    // 화면 회전(가로/세로 변경) 시 스크롤 중앙 정렬 유지
    window.addEventListener('resize', () => {
      scrollToCurrent();
    });

    // --- 초기화 ---
    window.addEventListener('DOMContentLoaded', () => {
      state.chunks = parseScript(DEFAULT_SCRIPT);
      renderScript();
      initSpeechRecognition();
    });
  </script>
</body>
</html>
